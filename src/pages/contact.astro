---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site.js";
---
<BaseLayout
  active="Contact"
  title="Contact | Sarthak Neupane"
  description="Contact Sarthak Neupane about applied AI/ML, energy systems, research, engineering opportunities and collaborations."
>
  <section class="contact-hero container">
    <p class="eyebrow">CONTACT / 05</p>

    <h1>Have a problem<br />worth <em>working on?</em></h1>

    <p class="page-lede">
      I am open to conversations about applied AI/ML, energy systems,
      research, engineering opportunities and meaningful collaborations.
    </p>

    <a class="contact-email" href={`mailto:${site.email}`}>
      {site.email} <span>↗</span>
    </a>
  </section>

  <section class="section section-tint">
    <div class="container contact-grid">

      <a href={`mailto:${site.email}`}>
        <span>01 / EMAIL</span>
        <b>{site.email}</b>
        <i>↗</i>
      </a>

      <a href={site.github} target="_blank" rel="noopener noreferrer">
        <span>02 / GITHUB</span>
        <b>github.com/Sarthakneu2</b>
        <i>↗</i>
      </a>

      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
        <span>03 / LINKEDIN</span>
        <b>LinkedIn Profile</b>
        <i>↗</i>
      </a>

      <a href="/cv/">
        <span>04 / CV</span>
        <b>View my CV</b>
        <i>↗</i>
      </a>

    </div>
  </section>
</BaseLayout>