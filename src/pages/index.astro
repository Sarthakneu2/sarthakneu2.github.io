---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { projects } from "../data/projects.js";
import { site, experience } from "../data/site.js";
const featured = projects.slice(0, 3);
---
<BaseLayout active="Home" title="Sarthak Neupane | Electrical Engineer · Applied AI/ML" description="The portfolio of Sarthak Neupane: electrical engineering, applied AI/ML, energy systems, research and quantitative analysis.">
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> ELECTRICAL ENGINEER · OPEN TO OPPORTUNITIES</p>
      <h1>Engineering at the intersection of <em>energy, data</em> and intelligent systems.</h1>
      <p class="hero-lede">{site.intro} I enjoy turning technical curiosity into practical systems that solve real problems.</p>
      <div class="hero-actions">
        <a class="button button-dark" href="/projects/">Explore my work <span>↗</span></a>
        <a class="button button-light" href="/about/">My story <span>↓</span></a>
      </div>
      <div class="hero-footnote"><span>BASED IN NEPAL</span><span>AVAILABLE FOR COLLABORATION</span></div>
    </div>
    <div class="hero-visual">
      <ResponsiveImage
        src="/images/potrait.jpg"
        alt="Portrait of Sarthak Neupane."
        sizes="(max-width: 900px) calc(100vw - 40px), 42vw"
        loading="eager"
        fetchPriority="high"
        objectPosition="center 42%"
      />
      <div class="visual-caption"><span>01 / A curious engineer</span><span>Electrical · Software · Data</span></div>
      <div class="hero-stamp">BUILD<br />WITH<br />PURPOSE.</div>
    </div>
  </section>

  <section class="ticker" aria-label="Areas of interest">
    <div class="container ticker-inner"><span>WHAT I WORK AROUND</span><b>ENERGY SYSTEMS</b><i>✳</i><b>APPLIED AI / ML</b><i>✳</i><b>DATA & SOFTWARE</b><i>✳</i><b>EMBEDDED SYSTEMS</b></div>
  </section>

  <section class="section container">
    <SectionHeading index="01" eyebrow="THE THROUGH-LINE" title="A journey from circuits to intelligent systems." text="My engineering journey began with electronics and gradually expanded into embedded programming, data analysis, software development and applied research." />
    <div class="story-strip">
      <div class="story-photo">
        <ResponsiveImage
          src="/images/picogrid.jpeg"
          alt="PicoGrid energy monitoring prototype."
          sizes="(max-width: 900px) calc(100vw - 40px), 38vw"
          objectFit="contain"
        />
      </div>
      <div class="story-text">
        <p class="large-quote">“I am most curious about what happens when data and machine learning meet the physical world.”</p>
        <p>That curiosity has taken me from building sensor-based prototypes to modelling hybrid energy systems, exploring agrivoltaics and developing quantitative strategies with Python.</p>
        <a class="text-link" href="/about/">Read my story <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="container">
      <SectionHeading index="02" eyebrow="SELECTED WORK" title="Projects built through curiosity." text="A selection of academic projects and research work. Each project page explains the problem, my contribution and the technical approach." />
      <div class="project-grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="section-end"><span>01—06 / PROJECT ARCHIVE</span><a class="button button-outline" href="/projects/">View all projects <span>↗</span></a></div>
    </div>
  </section>

  <section class="section container">
    <SectionHeading index="03" eyebrow="EXPERIENCE" title="Learning by building, researching and observing." text="My experience spans quantitative research, power distribution, hydropower and agrivoltaics." />
    <div class="timeline">
      {experience.map((item, i) => (
        <a class="timeline-row" href={item.org === "Quanta Investment" ? "/experience/" : item.org.includes("Agrivoltaics") ? "/experience/" : "/experience/"}>
          <span class="timeline-no">0{i + 1}</span>
          <div><h3>{item.org}</h3><p>{item.role} · {item.type}</p></div>
          <span class="timeline-period">{item.period}</span><span class="timeline-arrow">↗</span>
        </a>
      ))}
    </div>
    <div class="section-end"><span>EXPERIENCE & RESEARCH</span><a class="text-link" href="/experience/">View experience <span>↗</span></a></div>
  </section>

  <section class="quote-band">
    <div class="container quote-band-inner">
      <p class="eyebrow">WHAT DRIVES ME</p>
      <h2>Understand the system.<br /><em>Find the signal.</em><br />Build what helps.</h2>
      <a class="button button-light" href="/contact/">Start a conversation <span>↗</span></a>
    </div>
  </section>
</BaseLayout>
