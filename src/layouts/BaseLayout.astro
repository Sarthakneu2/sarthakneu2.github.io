---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
  title = "Sarthak Neupane | Electrical Engineer & Applied AI/ML",
  description = "Electrical engineering, applied AI/ML, intelligent energy systems, research and quantitative analysis.",
  active = ""
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f4ef" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header active={active} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
