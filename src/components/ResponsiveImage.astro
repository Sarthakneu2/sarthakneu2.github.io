---
import imageManifest from "../data/optimized-images.json";

const {
  src,
  alt,
  sizes = "100vw",
  loading = "lazy",
  fetchPriority,
  objectFit = "cover",
  objectPosition = "center",
  class: className = ""
} = Astro.props;

const image = imageManifest[src];
if (!image) throw new Error(`No optimized image variants found for ${src}`);

const makeSrcSet = (variants) => variants.map(({ src: variantSrc, width }) => `${variantSrc} ${width}w`).join(", ");
---
<picture class={className} style="display: block; width: 100%; height: 100%;">
  <source type="image/avif" srcset={makeSrcSet(image.variants.avif)} sizes={sizes} />
  <source type="image/webp" srcset={makeSrcSet(image.variants.webp)} sizes={sizes} />
  <img
    src={src}
    sizes={sizes}
    alt={alt}
    width={image.width}
    height={image.height}
    loading={loading}
    decoding="async"
    fetchpriority={fetchPriority}
    style={`object-fit: ${objectFit}; object-position: ${objectPosition};`}
  />
</picture>
